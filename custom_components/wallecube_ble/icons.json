{
  "entity": {
    "binary_sensor": {
      "discharging": {
        "default": "mdi:battery-arrow-down-outline"
      },
      "shutdown_imminent": {
        "default": "mdi:power-plug-off-outline"
      },
      "wifi_connected": {
        "default": "mdi:wifi",
        "state": {
          "off": "mdi:wifi-off"
        }
      }
    },
    "event": {
      "power_event": {
        "default": "mdi:transmission-tower",
        "state_attributes": {
          "event_type": {
            "state": {
              "power_lost": "mdi:power-plug-off-outline",
              "power_restored": "mdi:power-plug-outline"
            }
          }
        }
      }
    },
    "number": {
      "adapter_voltage": {
        "default": "mdi:power-plug-outline"
      },
      "adapter_current": {
        "default": "mdi:power-plug-outline"
      },
      "standby_time": {
        "default": "mdi:sleep"
      },
      "standby_current_threshold": {
        "default": "mdi:current-dc"
      },
      "screen_timeout": {
        "default": "mdi:monitor-off"
      },
      "screen_brightness": {
        "default": "mdi:brightness-6"
      },
      "screen_idle_brightness": {
        "default": "mdi:brightness-4"
      }
    },
    "select": {
      "temperature_unit": {
        "default": "mdi:thermometer"
      },
      "screen_language": {
        "default": "mdi:translate"
      },
      "buzzer_mode": {
        "default": "mdi:volume-high",
        "state": {
          "mute": "mdi:volume-off",
          "once": "mdi:bell-ring-outline",
          "repeat": "mdi:bell-alert-outline"
        }
      }
