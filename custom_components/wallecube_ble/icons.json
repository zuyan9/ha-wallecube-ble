    "sensor": {
      "battery_current": {
        "default": "mdi:current-dc"
      },
      "remaining_time_discharging": {
        "default": "mdi:battery-clock-outline"
      },
      "power_board_firmware_version": {
        "default": "mdi:chip"
      },
      "power_board_hardware_version": {
        "default": "mdi:chip"
      },
      "wifi_ssid": {
        "default": "mdi:wifi"
      },
      "wifi_ip_address": {
        "default": "mdi:ip-network-outline"
      },
      "cell_voltage_difference": {
        "default": "mdi:scale-balance"
      },
      "battery_health": {
        "default": "mdi:battery-heart-variant"
      },
      "battery_cycles": {
        "default": "mdi:battery-sync-outline"
      }
    },
    "switch": {
