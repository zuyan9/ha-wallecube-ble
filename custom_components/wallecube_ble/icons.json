    "binary_sensor": {
      "discharging": {
        "default": "mdi:battery-arrow-down-outline"
      },
      "shutdown_imminent": {
        "default": "mdi:power-plug-off-outline"
      }
    },
    "number": {
      "adapter_voltage": {
        "default": "mdi:power-plug-outline"
      },
      "adapter_current": {
        "default": "mdi:power-plug-outline"
      },
      "standby_time": {
        "default": "mdi:sleep"
      },
